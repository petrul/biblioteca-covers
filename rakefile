require 'json'
require 'open3'
require 'shellwords'
require 'socket'

PACKAGE = JSON.parse(File.read(File.expand_path('package.json', __dir__))).freeze
puts "#{PACKAGE.fetch('name')} version #{PACKAGE.fetch('version')}"

# Same mechanism as biblioteca-reader's, biblioteca-server's and
# biblioteca-nestjs's rakefiles: source the pass store's own load-env.sh for
# biblioteca/<profile> - both the encrypted secrets and the plain stage
# config - straight into the environment. The thumbnail allowlist is built
# from MINIO_URL / MINIO_PUBLIC_URL (see src2/config.ts), so a covers server
# started without the profile rejects every thumbnail; load it for both
# running and testing.
def load_profile!(profile)
    store_dir = ENV.fetch('PASSWORD_STORE_DIR', File.expand_path('~/.password-store'))
    loader = File.join(store_dir, 'load-env.sh')
    abort "Password-store environment loader not found: #{loader}" unless File.file?(loader)
    profile_path = "biblioteca/#{profile}"
    output, status = Open3.capture2('bash', '-c', "source #{Shellwords.escape(loader)} #{Shellwords.escape(profile_path)} && env -0")
    abort "Could not load biblioteca/#{profile} from pass store" unless status.success?
    output.split("\0").each do |entry|
        key, value = entry.split('=', 2)
        ENV[key] = value if key && value && !key.start_with?('_')
    end
    puts "> Loaded biblioteca/#{profile} from #{loader}"
end

def selected_profile(args)
    args[:profile] || ENV['PROFILE'] || Socket.gethostname.split('.').first
end

desc 'Print the package version from package.json'
task :version do
    puts PACKAGE.fetch('version')
end

desc 'Remove generated build artifacts'
task :clean do
    sh 'npm run clean'
end

desc 'Install exactly the dependencies recorded in package-lock.json'
task :npminstall do
    sh 'npm ci'
end

desc 'npminstall, but only when node_modules is absent'
task :ensure_deps do
    Rake::Task[:npminstall].invoke unless File.directory?('node_modules')
end

desc 'Build the production bundle'
task :build => [:ensure_deps] do
    sh 'npm run build'
end

desc 'Typecheck and run the API end-to-end test suite with a profile (hostname by default)'
task :test, [:profile] => [:ensure_deps] do |_task, args|
    load_profile!(selected_profile(args))
    sh 'npm run lint'
    sh 'npx', 'tsx', '--test', 'src2/thumbnails.test.ts'
    sh 'npm run test:e2e'
end

desc 'Run the dev server using a pass-store profile (hostname by default)'
task :run, [:profile] => [:ensure_deps] do |_task, args|
    load_profile!(selected_profile(args))
    sh 'npm run dev'
end

namespace :docker do
    desc 'Build the Docker image tagged with the package.json version'
    task :build do
        image = ENV.fetch('DOCKER_IMAGE', 'editii/biblioteca-covers')
        tag = "#{image}:#{PACKAGE.fetch('version')}"

        sh 'docker', 'build', '--tag', tag, '.'
        puts "Built #{tag}"
    end

    desc 'Build and publish the versioned Docker image to mini.local:5000'
    task :publish => [:build] do
        image = ENV.fetch('DOCKER_IMAGE', 'editii/biblioteca-covers')
        version = PACKAGE.fetch('version')
        local_tag = "#{image}:#{version}"
        remote_tag = "mini.local:5000/#{image}:#{version}"

        sh 'docker', 'tag', local_tag, remote_tag
        sh 'docker', 'push', remote_tag
        puts "Published #{remote_tag}"
    end
end

desc 'Run the complete CI pipeline: clean, test, build, and publish the Docker image'
task :ci => [:clean, :npminstall] do
    Rake::Task[:test].invoke
    Rake::Task[:build].invoke
    Rake::Task['docker:publish'].invoke
end
