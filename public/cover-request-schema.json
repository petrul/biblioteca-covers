{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cover configuration request",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "author": { "type": "string" },
    "publisher": { "type": "string" },
    "pubPlace": { "type": "string" },
    "date": { "type": ["string", "number"] },
    "isbn": { "type": "string" },
    "series": { "type": "string" },
    "volume": { "type": "string" },
    "taglineQuote": { "type": "string" },
    "genre": { "type": "string" },
    "coverArtUrl": { "type": "string" },
    "imageUrl": { "type": "string" },
    "graphicUrl": { "type": "string" },
    "portraitUrl": { "type": "string" },
    "applyVintageFilter": { "type": "boolean", "default": false },
    "vintageFilter": { "type": "boolean" },
    "agingFilter": { "type": "boolean" },
    "bwFilter": { "type": "boolean" },
    "portraitTreatment": { "type": "string" },
    "treatment": { "type": "string" },
    "cropShape": { "type": "string", "default": "full_bleed" },
    "zoom": { "type": "number", "default": 1 },
    "panX": { "type": "number", "default": 0 },
    "panY": { "type": "number", "default": 0 },
    "layout": { "type": "string", "default": "archival_monograph" },
    "archetypeId": { "type": "string" },
    "paletteId": { "type": "string", "default": "archival_alabaster" },
    "foilEffect": { "type": "string", "default": "none" }
  },
  "additionalProperties": true
}
